  "nodes": {
    "postKeeper.offer.post": {"end": true, "lines": [
      "There's work at the post, if you've the time."
    ], "speaker": "postKeeper"},
    "postKeeper.offer.ford": {"end": true, "lines": [
      "The ford wants walking. Nobody's checked it in years."
    ], "speaker": "postKeeper"},
    "postKeeper.offer.bend": {"end": true, "lines": [
      "Bend stone needs an errand run. My knees say no."
    ], "speaker": "postKeeper"},
    "postKeeper.notReady": {"end": true, "lines": [
      "Not yet. The road's still waiting on you."
    ], "speaker": "postKeeper"},
    "postKeeper.notReady.2": {"end": true, "lines": [
      "Done already? Your boots say otherwise."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.1": {"end": true, "lines": [
      "Good. I'll put it on the tally. Take this."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.2": {"end": true, "lines": [
      "Well walked. The post pays what it can."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.packet": {"end": true, "lines": [
      "Oilcloth, still sealed. You didn't look. Good."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.shield": {"end": true, "lines": [
      "That buckler found you at the Bend. Keep it."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.sign": {"end": true, "lines": [
      "My west arm. The river had it. Thank you."
    ], "speaker": "postKeeper"},
    "postKeeper.thanks.shrine": {"end": true, "lines": [
      "You looked at the shrine? Good. Someone should."
    ], "speaker": "postKeeper"},
    "postKeeper.greet": {"end": true, "lines": [
      "Back again. The basket's lighter than it was."
    ], "speaker": "postKeeper"},
    "postKeeper.greet.first": {"end": true, "lines": [
      "Leave what you can spare. Take what you need."
    ], "setFlag": "postKeeper.met", "speaker": "postKeeper"}
  }
