{
  "kind": "dialogue",
  "schema": 1,
  "id": "npcsignalhill",
  "speakers": {
    "npcSignalHill": {"label": "JORY"},
    "you": {"label": "YOU", "player": true}
  },
  "entry": [
    {"node": "npcSignalHill.thanks", "requires": "npcSignalHill.after.sq.reg.signalHill"},
    {"node": "npcSignalHill.notReady", "requires": "q.sq.reg.signalHill.active"},
    {"node": "npcSignalHill.offer", "requires": "q.sq.reg.signalHill.available"},
    {"node": "npcSignalHill.greet"}
