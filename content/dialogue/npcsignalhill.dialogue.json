  "nodes": {
    "npcSignalHill.greet": {"end": true, "lines": [
      "Short, long, short. I watch the stone all day."
    ], "speaker": "npcSignalHill"},
    "npcSignalHill.offer": {"end": true, "lines": [
      "Wolves on the slope. When they're near, it stutters."
    ], "speaker": "npcSignalHill"},
    "npcSignalHill.notReady": {"end": true, "lines": [
      "It stutters still. They're close."
    ], "speaker": "npcSignalHill"},
    "npcSignalHill.thanks": {"end": true, "lines": [
      "Listen. It runs clean again. Arrows, take them."
    ], "speaker": "npcSignalHill"}
  }
}
