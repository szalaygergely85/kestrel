    "npcReedmire.greet": {"end": true, "lines": [
      "Keep to the planks. The black water keeps what it takes."
    ], "speaker": "npcReedmire"},
    "npcReedmire.offer": {"end": true, "lines": [
      "Three boars wallow in the reeds. They broke my punt."
    ], "speaker": "npcReedmire"},
    "npcReedmire.notReady": {"end": true, "lines": [
      "Still wallowing. Still loud."
    ], "speaker": "npcReedmire"},
    "npcReedmire.thanks": {"end": true, "lines": [
      "Quiet water. Take these arrows. Dry ones."
    ], "speaker": "npcReedmire"}
  }
