    {
      "id": "sq.hw.piers",
      "title": "The Pulled Bridge",
      "site": "pierStone",
      "objectives": [
        {
          "id": "read",
          "text": "Read the stone north of the road",
          "when": {
            "type": "flag",
            "id": "lore.pierStone.read",
            "equals": true
          }
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 10
          }
        ]
      },
      "lines": {
        "offer": [
          "A tall stone by the track. Cut square, set on end.",
          "Marks on one face. Too worn to read from here."
        ],
        "active": [
          "The stone by the track. Read it up close."
        ],
        "ready": [
          "Bridge stone. Pulled down from the west bank.",
          "Behind it, in the grass, ten arrows tied with twine."
        ],
        "done": [
          "The stone stands. The river runs where the bridge was."
        ]
      }
    },
    {
      "id": "sq.fc.sign",
      "title": "The West Arm",
      "site": "post",
      "steps": [
        {
          "template": "fetch",
          "params": {
            "item": "signArm"
          },
          "objText": "Find the sign arm in the shallows"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 10
          }
        ]
      },
      "returnText": "Bring the sign arm to the ford post",
      "lines": {
        "offer": [
          "A tag on the basket: THE WEST ARM OF THE SIGN FELL.",
          "IN THE SHALLOWS BY THE FORD. BRING IT BACK."
        ],
        "active": [
          "The tag: WEST ARM. IN THE SHALLOWS."
        ],
        "ready": [
          "You lay the arm in the basket. The wood is river-black.",
          "Under it, tied with twine: ten arrows."
        ],
        "done": [
          "The tag: WEST POINTS WEST AGAIN. THANK YOU."
        ]
      }
    },
