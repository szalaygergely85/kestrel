          "quest": "mq.ow.names",
          "done": true
        }
      ],
      "abandonable": false
    },
    {
      "id": "mq.ow.board",
      "title": "The Board of the Dead",
      "main": true,
      "site": "owBoard",
      "band": 6,
      "objectives": [
        {
          "id": "read",
          "text": "Read the board in the plaza",
          "when": {
            "type": "flag",
            "id": "lore.owBoard.read",
            "equals": true
          }
        }
      ],
      "requires": [
        {
          "quest": "mq.ow.relay",
          "done": true
        }
      ],
      "reward": {
        "items": [
          {
            "id": "chart.westFells",
            "n": 1
          }
        ]
      },
      "lines": {
        "offer": [
          "NEEDS WRITER mq.ow.board.offer.1",
          "NEEDS WRITER mq.ow.board.offer.2"
        ],
        "active": [
          "NEEDS WRITER mq.ow.board.active.1"
        ],
        "ready": [
          "NEEDS WRITER mq.ow.board.ready.1",
          "NEEDS WRITER mq.ow.board.ready.2"
        ],
        "done": [
          "NEEDS WRITER mq.ow.board.done.1"
        ]
      },
      "abandonable": false
    },
    {
      "id": "sq.hw.piers",
      "title": "The Pulled Bridge",
      "site": "pierStone",
      "objectives": [
        {
          "id": "read",
          "text": "Read the stone north of the road",
          "when": {
            "type": "flag",
            "id": "lore.pierStone.read",
            "equals": true
          }
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 10
          }
        ]
      },
      "lines": {
        "offer": [
          "A tall stone by the track. Cut square, set on end.",
          "Marks on one face. Too worn to read from here."
        ],
        "active": [
          "The stone by the track. Read it up close."
        ],
        "ready": [
          "Bridge stone. Pulled down from the west bank.",
          "Behind it, in the grass, ten arrows tied with twine."
        ],
        "done": [
          "The stone stands. The river runs where the bridge was."
        ]
      }
    },
    {
      "id": "sq.fc.sign",
      "title": "The West Arm",
      "site": "post",
      "steps": [
        {
          "template": "fetch",
          "params": {
            "item": "signArm"
          },
          "objText": "Find the sign arm in the shallows"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 10
          }
        ]
      },
      "returnText": "Bring the sign arm to the ford post",
      "lines": {
        "offer": [
          "A tag on the basket: THE WEST ARM OF THE SIGN FELL.",
          "IN THE SHALLOWS BY THE FORD. BRING IT BACK."
        ],
        "active": [
          "The tag: WEST ARM. IN THE SHALLOWS."
        ],
        "ready": [
          "You lay the arm in the basket. The wood is river-black.",
          "Under it, tied with twine: ten arrows."
        ],
        "done": [
          "The tag: WEST POINTS WEST AGAIN. THANK YOU."
        ]
      }
    },
    {
      "id": "sq.ow.wolves",
      "title": "Wolf Bounty",
      "site": "owBoard",
      "steps": [
        {
          "template": "kill",
          "params": {
            "ids": [
              "wolf1",
              "wolf2",
              "wolf3",
              "wolf4",
              "wolf5"
            ],
            "count": 3
          },
          "objText": "Drive three wolves from the goose pen"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 10
          },
          {
            "id": "potion.hp",
            "n": 1
          }
        ]
      },
      "lines": {
        "offer": [
          "A new nail, over the Crown notices. A fresh hand:",
          "WOLVES AT THE GEESE AGAIN. THREE FEWER, FAIR PAY."
        ],
        "active": [
          "The note: WOLVES. GOOSE PEN. THREE."
        ],
        "ready": [
          "Under the note now, tied with twine: arrows, a red vial."
        ],
        "done": [
          "Someone has written under it: GEESE COUNTED. ALL HERE."
        ]
      }
    },
    {
      "id": "sq.ow.boars",
      "title": "Boar Bounty",
      "site": "owBoard",
      "steps": [
        {
          "template": "kill",
          "params": {
            "ids": [
              "boarF1",
              "boarF2"
            ],
            "count": 2
          },
          "objText": "Drive off two boars on the west bank"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "table": "gear.t2"
      },
      "lines": {
        "offer": [
          "Another note, same hand, nailed over a FELL notice:",
          "TWO BOARS ROOTING ON THE WEST BANK. MIND THE TUSKS."
        ],
        "active": [
          "The note: TWO BOARS. WEST BANK. TUSKS."
        ],
        "ready": [
          "Under the note, wrapped in sacking: old gear, oiled."
        ],
        "done": [
          "Under the note, a new line: THE BANK IS QUIET. THANKS."
        ]
      }
    },
    {
      "id": "sq.ow.parcel",
      "title": "Parcel for the Forge",
      "site": "owBoard",
      "steps": [
        {
          "template": "deliver",
          "params": {
            "item": "parcel",
            "to": "owForge"
          },
          "objText": "Take the parcel to the forge"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "potion.hp",
            "n": 2
          }
        ]
      },
      "lines": {
        "offer": [
          "A parcel hangs from a nail, wrapped in oilcloth.",
          "Tag: FOR THE FORGE. LEAVE IT BY THE DOOR."
        ],
        "active": [
          "The tag: FOR THE FORGE. BY THE DOOR."
        ],
        "ready": [
          "You set the parcel by the forge door. It clinks.",
          "On the step, waiting: two red vials."
        ],
        "done": [
          "The parcel tag is gone. The nail is bare."
        ]
      }
    },
    {
      "id": "sq.ow.ford",
      "title": "Scout the Far Bank",
      "site": "pierStone",
      "steps": [
        {
          "template": "explore",
          "params": {
            "areas": [
              "fordWest"
            ]
          },
          "objText": "Cross the ford to the west bank"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 15
          }
        ]
      },
      "lines": {
        "offer": [
          "Across the water, the other half of the old pier.",
          "Someone pulled the bridge from that side. Go and see."
        ],
        "active": [
          "The far pier. Across the ford, on the west bank."
        ],
        "ready": [
          "The west pier: rope grooves, worn deep. A crossing.",
          "In a dry crack of the stone: fifteen arrows, waxed."
        ],
        "done": [
          "Two piers, one river. Neither side built it back."
        ]
      }
    },
    {
      "id": "sq.ow.barley",
      "title": "Barley Sheaf",
      "site": "owBoard",
      "steps": [
        {
          "template": "fetch",
          "params": {
            "item": "barleySheaf"
          },
          "objText": "Fetch the sheaf at the barley gate"
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "potion.hp",
            "n": 1
          },
          {
            "id": "arrow",
            "n": 10
          }
        ]
      }
    },
    {
      "id": "sq.ow.range",
      "title": "Track Targets",
      "site": "owBoard",
      "objectives": [
        {
          "id": "t1",
          "text": "Hit target 1",
          "when": {
            "type": "flag",
            "id": "owTarget1.hit",
            "equals": true
          }
        },
        {
          "id": "t2",
          "text": "Hit target 2",
          "when": {
            "type": "flag",
            "id": "owTarget2.hit",
            "equals": true
          }
        },
        {
          "id": "t3",
          "text": "Hit target 3",
          "when": {
            "type": "flag",
            "id": "owTarget3.hit",
            "equals": true
          }
        }
      ],
      "opensAfter": [
        "mq.ford.mirror"
      ],
      "reward": {
        "items": [
          {
            "id": "arrow",
            "n": 15
          }
        ]
      },
      "returnText": "Back to the board"
    }
  ]
