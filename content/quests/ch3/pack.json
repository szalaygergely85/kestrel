    {
      "id": "mq.ow.relay",
      "title": "The Village Relay",
      "main": true,
      "site": "hesk",
      "band": 6,
      "objectives": [
        {
          "id": "talk",
          "text": "Ask Dorrin about the brass",
          "when": {
            "type": "flag",
